# Copie para .env e ajuste.

# Segredo que assina os tokens de login dos tatuadores. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque-por-um-segredo-longo

# Validade do login, em minutos.
JWT_EXPIRA_MINUTOS=480

# Senha dos 6 tatuadores de demonstração (<slug>@exemplo.com), criados no primeiro start.
# Deixe vazio para não criar.
SENHA_DEMO=tatuo-demo

# Onde ficam o banco SQLite e as imagens enviadas (padrão: raiz do projeto).
# DB_PATH=tatuo.db
# UPLOADS_DIR=uploads

# ---------- pagamentos (Fase 2) ----------
# "simulado" = sem dinheiro de verdade (PIX de demonstração e checkout de teste).
PROVEDOR_PAGAMENTO=simulado
# Taxa do Tatuo sobre cada pagamento pelo app, em %.
TAXA_PLATAFORMA_PCT=8
# Recebedor do PIX (no modelo de custódia, a conta do Tatuo).
PIX_CHAVE=pagamentos@exemplo.com
PIX_NOME=TATUO DEMO
PIX_CIDADE=RIO DE JANEIRO
